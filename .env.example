# ── required ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"   # Supabase "Transaction pooler" URL (or any Postgres)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"                    # Supabase "Session"/direct URL (used for migrations)
AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# first admin created by the seed script
ADMIN_EMAIL="owner@your-domain.com"
ADMIN_PASSWORD="choose-a-strong-password"
SEED_BASE_CURRENCY="PKR"          # base currency for the books (PKR, USD, GBP, EUR…) — set before first seed

# ── payments (optional; the checkout shows only what is configured) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""           # webhook endpoint: https://your-domain.com/api/webhooks/stripe
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"               # or "live"

# ── media uploads (required on Vercel; local dev writes to /public/uploads) ──
UPLOADTHING_TOKEN=""

# ── email (optional; without it emails are logged to the console) ──
RESEND_API_KEY=""
EMAIL_FROM="Creative Corner <orders@your-domain.com>"

# ── automation & SEO ──
CRON_SECRET=""                     # protects /api/cron/daily (Vercel Cron sends it automatically)
INDEXNOW_KEY=""                    # any random string; enables instant Bing/Yandex indexing pings
FX_API_URL=""                      # optional custom FX endpoint; default open.er-api.com
